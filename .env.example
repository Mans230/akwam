BOT_TOKEN=
AKWAM_DOMAIN=https://akwam.it
ADMIN_IDS=123456789
FORCE_CHANNEL=@yourchannel
BOT_API_SERVER=http://telegram-bot-api:8081
TG_API_ID=
TG_API_HASH=
DEFAULT_MAX_CONCURRENT=1
# عدد قطع التحميل المتوازي (زي IDM) للسيرفرات اللي بتدعم Range — للملفات الأكبر من 10 ميجا
DOWNLOAD_SEGMENTS=8
# نظام الموافقات: 1 = أي مستخدم جديد لازم موافقة الأدمن قبل استخدام البوت (0 = الوضع الحالي بدون موافقة)
REQUIRE_APPROVAL=0
# عدد قطع التحميل المتوازي لمستخدمي البريميوم (المستخدم العادي ياخد DOWNLOAD_SEGMENTS)
PREMIUM_SEGMENTS=16
CACHE_TTL_HOURS=6
EPISODES_PER_PAGE=20
DOWNLOAD_DIR=./downloads
DB_PATH=./data/bot.db
# دومين ستار سيما (الموقع التاني للبحث) — الدومين البديل المعلن starcima.cc لو الأساسي اتغير
STARCIMA_DOMAIN=https://starcima.com
# عدد سيرفرات المشاهدة المعروضة في الصفحة الواحدة (ستار سيما)
SERVERS_PER_PAGE=10
# دومين موقع موفي بوكس (الموقع التالت للبحث + زر الرائج 🔥)
MOVIEBOX_DOMAIN=https://themoviebox.xyz
